// Schema do Mov+ — escopo atual: autenticação (User, Session, AuditLog).
// Demais entidades de docs/architecture/DATA_MODEL.md entram em branches próprias.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MOTORISTA
}

model User {
  id           String   @id @default(uuid(7)) @db.Uuid
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  sessions  Session[]
  auditLogs AuditLog[]

  @@map("users")
}

/// Sessão no servidor: o JWT carrega apenas o id da sessão. Logout revoga a
/// sessão, invalidando o token imediatamente.
model Session {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @db.Uuid
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt DateTime  @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model AuditLog {
  id          String   @id @default(uuid(7)) @db.Uuid
  actorUserId String   @db.Uuid
  action      String
  entityType  String
  entityId    String   @db.Uuid
  occurredAt  DateTime @default(now()) @db.Timestamptz(3)
  reason      String?
  /// Mudanças minimizadas: nunca incluir dados pessoais completos nem segredos.
  changes     Json?

  actor User @relation(fields: [actorUserId], references: [id])

  @@index([entityType, entityId])
  @@index([actorUserId])
  @@map("audit_logs")
}
