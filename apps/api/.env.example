# Copie para .env (ignorado pelo Git) e ajuste. Nunca versione valores reais.
DATABASE_URL="postgresql://USUARIO@localhost:5432/mov_dev"
PORT=3000
WEB_ORIGIN=http://localhost:5173
# Gere com: openssl rand -base64 48
JWT_SECRET=""
# Duração da sessão em segundos. Política definitiva ainda PENDING (ARCHITECTURE.md §6).
SESSION_TTL_SECONDS=3600

# Recuperação de senha
# Validade do token de redefinição, em segundos (padrão 1800 = 30 min).
PASSWORD_RESET_TTL_SECONDS=1800
# Envio por e-mail via API HTTP do Brevo (SMTP é bloqueado no Render free).
# Sem estas duas variáveis, vale o modo de desenvolvimento abaixo.
# BREVO_API_KEY=
# E-mail remetente verificado no Brevo (Senders & IP).
# MAIL_FROM_EMAIL=
# MAIL_FROM_NAME=Mov+
# Somente em desenvolvimento, "true" imprime o
# link de recuperação no console (nunca usar em produção).
PASSWORD_RESET_DEV_LOG=false
# URL do front que recebe ?token=... (padrão: WEB_ORIGIN + /redefinir-senha).
# PASSWORD_RESET_URL=
